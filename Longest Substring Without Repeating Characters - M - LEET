class Solution {
    public int lengthOfLongestSubstring(String s) {
        HashMap<Character,Integer> map = new HashMap<>();
        int n = s.length();
        int l = 0;
        int maxLen = 0;
        for(int r=0;r<n;r++){
            char c = s.charAt(r);
            if(map.containsKey(c)){
            l = Math.max(l,map.getOrDefault(c,0)+1);
            }
            //add to map
            map.put(c,r);
            maxLen = Math.max(maxLen, r-l+1);
        }
        return maxLen;
    }
}
